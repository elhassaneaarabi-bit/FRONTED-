# ════════════════════════════════════════════════════════════
# FRONTEND ENVIRONMENT (Next.js) — copy to ".env.local"
# NOTE: every NEXT_PUBLIC_* value is exposed to the browser.
# ════════════════════════════════════════════════════════════

# ── Core ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_API_URL=https://api.your-domain.com

# ── Contact ──────────────────────────────────────────────────
# WhatsApp number in international format, no "+"
NEXT_PUBLIC_WHATSAPP_NUMBER=966500000000

# ── Google Maps (optional) ───────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_URL=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Analytics & marketing pixels (optional) ──────────────────
# Google Analytics 4 — e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA4_ID=
# Meta (Facebook) Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=
# TikTok Pixel ID / code
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
# Snapchat Pixel ID
NEXT_PUBLIC_SNAP_PIXEL_ID=
