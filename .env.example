# ─────────────────────────────────────────────
# Frontend environment variables (Next.js)
# Copy this file to ".env.local" and fill in real values.
# NOTE: NEXT_PUBLIC_* values are exposed to the browser.
# ─────────────────────────────────────────────

# Public site URL (used for SEO / canonical links)
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# WhatsApp contact number (international format, no +)
NEXT_PUBLIC_WHATSAPP_NUMBER=966500000000

# Google Maps location URL (optional)
NEXT_PUBLIC_GOOGLE_MAPS_URL=

# Google Maps JavaScript API key (optional)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX (optional)
NEXT_PUBLIC_GA4_ID=
